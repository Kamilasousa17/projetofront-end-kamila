import { useMemo } from "react";
import { useSearchParams } from "react-router-dom";
import { products, categories } from "../data/products.js";
import ProductCard from "../components/ProductCard.jsx";

export default function Products() {
  const [params, setParams] = useSearchParams();
  const busca = params.get("busca") || "";
  const categoria = params.get("categoria") || "Todas";
  const ordem = params.get("ordem") || "relevancia";

  const update = (key, value) => {
    const next = new URLSearchParams(params);
    if (value && value !== "Todas" && value !== "relevancia") next.set(key, value);
    else next.delete(key);
    setParams(next, { replace: true });
  };

  const lista = useMemo(() => {
    let r = products.filter(
      (p) =>
        (categoria === "Todas" || p.category === categoria) &&
        p.name.toLowerCase().includes(busca.toLowerCase())
    );
    if (ordem === "menor") r = [...r].sort((a, b) => a.price - b.price);
    if (ordem === "maior") r = [...r].sort((a, b) => b.price - a.price);
    if (ordem === "nota") r = [...r].sort((a, b) => b.rating - a.rating);
    if (ordem === "nome") r = [...r].sort((a, b) => a.name.localeCompare(b.name));
    return r;
  }, [busca, categoria, ordem]);

  return (
    <>
      <h1 className="section-title">Produtos</h1>

      <div className="filters">
        <input
          type="search"
          placeholder="Buscar produto..."
          value={busca}
          onChange={(e) => update("busca", e.target.value)}
        />
        <select value={categoria} onChange={(e) => update("categoria", e.target.value)}>
          {categories.map((c) => (
            <option key={c}>{c}</option>
          ))}
        </select>
        <select value={ordem} onChange={(e) => update("ordem", e.target.value)}>
          <option value="relevancia">Relevância</option>
          <option value="menor">Menor preço</option>
          <option value="maior">Maior preço</option>
          <option value="nota">Melhor avaliados</option>
          <option value="nome">Nome (A-Z)</option>
        </select>
      </div>

      <p className="muted">{lista.length} produto(s) encontrado(s)</p>

      {lista.length === 0 ? (
        <div className="empty">Nenhum produto encontrado.</div>
      ) : (
        <div className="grid">
          {lista.map((p) => (
            <ProductCard key={p.id} product={p} />
          ))}
        </div>
      )}
    </>
  );
}
import { useState } from "react";
import { Link, useNavigate, useParams } from "react-router-dom";
import { products, formatPrice } from "../data/products.js";
import { useCart } from "../context/CartContext.jsx";
import ProductCard from "../components/ProductCard.jsx";

export default function ProductDetail() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { addItem } = useCart();
  const [qty, setQty] = useState(1);
  const [added, setAdded] = useState(false);

  const product = products.find((p) => p.id === Number(id));

  if (!product) {
    return (
      <div className="empty">
        <h2>Produto não encontrado</h2>
        <Link className="btn" to="/produtos">Ver produtos</Link>
      </div>
    );
  }

  const related = products
    .filter((p) => p.category === product.category && p.id !== product.id)
    .slice(0, 3);

  const handleAdd = () => {
    addItem(product, qty);
    setAdded(true);
    setTimeout(() => setAdded(false), 2000);
  };

  return (
    <>
      <button className="link-back" onClick={() => navigate(-1)}>← Voltar</button>

      <section className="detail">
        <img src={product.image} alt={product.name} />
        <div>
          <span className="tag">{product.category}</span>
          <h1>{product.name}</h1>
          <p className="rating">⭐ {product.rating.toFixed(1)} / 5</p>
          <p className="price big">{formatPrice(product.price)}</p>
          <p className="muted">
            ou 10x de {formatPrice(product.price / 10)} sem juros
          </p>
          <p>{product.description}</p>

          <div className="qty">
            <button onClick={() => setQty((q) => Math.max(1, q - 1))}>−</button>
            <span>{qty}</span>
            <button onClick={() => setQty((q) => q + 1)}>+</button>
          </div>

          <div className="card-actions">
            <button className="btn" onClick={handleAdd}>
              {added ? "✔ Adicionado!" : "Adicionar ao carrinho"}
            </button>
            <Link className="btn btn-outline" to="/carrinho">Ir para o carrinho</Link>
          </div>
        </div>
      </section>

      {related.length > 0 && (
        <section>
          <h2 className="section-title">Produtos relacionados</h2>
          <div className="grid">
            {related.map((p) => (
              <ProductCard key={p.id} product={p} />
            ))}
          </div>
        </section>
      )}
    </>
  );
}
