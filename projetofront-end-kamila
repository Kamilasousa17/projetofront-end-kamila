            <div className="cart-info">
              <Link to={`/produtos/${i.id}`}>{i.name}</Link>
              <span className="muted">{formatPrice(i.price)}</span>
            </div>
            <div className="qty">
              <button onClick={() => updateQty(i.id, i.qty - 1)}>−</button>
              <span>{i.qty}</span>
              <button onClick={() => updateQty(i.id, i.qty + 1)}>+</button>
            </div>
            <strong>{formatPrice(i.price * i.qty)}</strong>
